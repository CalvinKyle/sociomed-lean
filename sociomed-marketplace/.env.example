# Database Settings (PostgreSQL)
DB_PASSWORD=test-password

# Google Gemini API Key (for PDF ingestion and AI responses)
GEMINI_API_KEY=your_gemini_key
POSTGRES_DB=${POSTGRES_DB}HOST=db
USER=${ODOO_USER}
PASSWORD=${ODOO_PASSWORD}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_USER=odoo

# WhatsApp Business API (Meta) - Leave blank for local testing
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_ID=your_phone_number_id_here
VERIFY_TOKEN=sociomed2025_test
ODOO_URL=http://web:8069
ODOO_DB=${ODOO_DB}
ODOO_USER=${ODOO_USER}
ODOO_PASSWORD=${ODOO_PASSWORD}
CELERY_BROKER_URL=redis://sociomed-redis:6379/0
CELERY_RESULT_BACKEND=redis://sociomed-redis:6379/0

# Optional: For advanced use
# DATABASE_URL=postgresql://sociomed_user:password@sociomed-database:5432/sociomed
