# Production environment for SocioMed Lean
APP_ENV=production

# WhatsApp Cloud API
VERIFY_TOKEN=sociomed-prod-webhook
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Google Sheets sync
GOOGLE_CREDS_FILE=.secrets/google-service-account.json
GOOGLE_CREDS_JSON=
SHEET_NAME=sociomed_db

# Data layer
DATABASE_URL=
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0

# Business settings
SALES_AGENT_PHONE=
SUPPORT_EMAIL=sales@socio-med.com
PUBLIC_BASE_URL=https://api.socio-med.com
ENABLE_OPEN_DOCS=false
DEFAULT_CURRENCY=UGX
API_KEY=
LAUNCH_MODE=true
ENABLE_FEATURED_OFFERS=false
ENABLE_CATEGORY_BROWSE=false
ENABLE_RELATED_PRODUCTS=false
EXPOSE_SUPPLIER_NAMES=false
MAX_AUTO_PFI_LEAD_TIME_DAYS=0

# Merchant identity and PFI terms — supply through production secrets, never source control
MERCHANT_LEGAL_NAME=
MERCHANT_TRADING_NAME=
MERCHANT_TAGLINE=
MERCHANT_ADDRESS_LINES_JSON=[]
MERCHANT_PHONE_LINES_JSON=[]
MERCHANT_EMAIL=
MERCHANT_WEBSITE=
MERCHANT_TAX_ID=
MERCHANT_VAT_WORDING=
MERCHANT_BANK_NAME=
MERCHANT_BANK_ACCOUNT_NAME=
MERCHANT_BANK_ACCOUNT_NUMBER=
MERCHANT_BANK_BRANCH=
MERCHANT_BANK_SWIFT=
PFI_VALIDITY_DAYS=14
PFI_PAYMENT_TERMS=
PFI_DELIVERY_TERMS=
PFI_CONSUMABLES_WARRANTY=
PFI_EQUIPMENT_WARRANTY=
PFI_EQUIPMENT_INSTALLATION=
PFI_TECHNICAL_SUPPORT=

# Runtime and logging
SESSION_TTL=1800
SESSION_VERSION=1
CACHE_TTL_SECONDS=300
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
EXCHANGE_RATES_JSON=
EXCHANGE_RATES_LAST_UPDATED=
MAX_EXCHANGE_RATE_AGE_DAYS=14
LOG_LEVEL=INFO
