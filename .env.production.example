# Production environment for SocioMed Lean
APP_ENV=production

# WhatsApp provider
WHATSAPP_PROVIDER=twilio
# Recommended for low-volume Twilio Sandbox testing without a Celery worker.
# Set true later when a Celery worker is deployed for production traffic.
ASYNC_WHATSAPP_PROCESSING=false

# Twilio WhatsApp Sandbox / approved sender
# Store real values in Render, never in this file or git.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_URL=https://YOUR-RENDER-SERVICE.onrender.com/api/webhook/twilio
TWILIO_STATUS_CALLBACK_URL=https://YOUR-RENDER-SERVICE.onrender.com/api/webhook/twilio/status

# Meta WhatsApp Cloud API (only required when WHATSAPP_PROVIDER=meta)
VERIFY_TOKEN=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Google Sheets sync
GOOGLE_CREDS_FILE=.secrets/google-service-account.json
GOOGLE_CREDS_JSON=
SHEET_NAME=sociomed_db

# Data layer
DATABASE_URL=
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0

# Business settings
SALES_AGENT_PHONE=
SUPPORT_EMAIL=sales@socio-med.com
PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
ENABLE_OPEN_DOCS=false
DEFAULT_CURRENCY=UGX
API_KEY=

# Runtime and logging
SESSION_TTL=1800
SESSION_VERSION=1
CACHE_TTL_SECONDS=300
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
EXCHANGE_RATES_JSON=
EXCHANGE_RATES_LAST_UPDATED=
MAX_EXCHANGE_RATE_AGE_DAYS=14
LOG_LEVEL=INFO
FLOWER_PASSWORD=
