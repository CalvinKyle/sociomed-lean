# Production environment for SocioMed Lean
APP_ENV=production

# WhatsApp Cloud API
VERIFY_TOKEN=sociomed-prod-webhook
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Google Sheets sync
GOOGLE_CREDS_FILE=.secrets/google-service-account.json
GOOGLE_CREDS_JSON=
SHEET_NAME=sociomed_db

# Data layer
DATABASE_URL=
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0

# Business settings
SALES_AGENT_PHONE=
SUPPORT_EMAIL=sales@sociomed.co
PUBLIC_BASE_URL=https://api.sociomed.co
ENABLE_OPEN_DOCS=false
DEFAULT_CURRENCY=UGX

# Runtime and logging
SESSION_TTL=1800
SESSION_VERSION=1
CACHE_TTL_SECONDS=300
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
EXCHANGE_RATES_JSON=
EXCHANGE_RATES_LAST_UPDATED=
MAX_EXCHANGE_RATE_AGE_DAYS=14
LOG_LEVEL=INFO
FLOWER_PASSWORD=
