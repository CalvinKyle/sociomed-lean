# Local development environment for SocioMed Lean
APP_ENV=development

# WhatsApp provider: twilio for beta testing, meta for the existing Cloud API integration
WHATSAPP_PROVIDER=twilio

# Twilio WhatsApp Sandbox
# Get these from Twilio Console > Account Dashboard and Messaging > Try it out > Send a WhatsApp message.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=https://YOUR-NGROK-DOMAIN.ngrok-free.app/api/webhook/twilio
TWILIO_STATUS_CALLBACK_URL=https://YOUR-NGROK-DOMAIN.ngrok-free.app/api/webhook/twilio/status

# Meta WhatsApp Cloud API (only required when WHATSAPP_PROVIDER=meta)
VERIFY_TOKEN=sociomed-local-webhook
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Google Sheets
GOOGLE_CREDS_FILE=.secrets/google-service-account.json
GOOGLE_CREDS_JSON=
SHEET_NAME=sociomed_db

# Database and queue
DATABASE_URL=postgresql://sociomed:sociomed_dev_password@localhost:5432/sociomed_local

REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Sales / go-to-market
SALES_AGENT_PHONE=+254700123456
SUPPORT_EMAIL=sales@socio-med.com
PUBLIC_BASE_URL=http://localhost:8000
ENABLE_OPEN_DOCS=true
DEFAULT_CURRENCY=UGX
API_KEY=sociomed-local-api-key

# Runtime
SESSION_TTL=1800
SESSION_VERSION=1
CACHE_TTL_SECONDS=300
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
EXCHANGE_RATES_JSON=
EXCHANGE_RATES_LAST_UPDATED=2026-04-30
MAX_EXCHANGE_RATE_AGE_DAYS=14

# Logging
LOG_LEVEL=INFO
