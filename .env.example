# Local development environment for SocioMed Lean
APP_ENV=development

# WhatsApp Cloud API
VERIFY_TOKEN=sociomed-local-webhook
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Google Sheets
GOOGLE_CREDS_FILE=.secrets/google-service-account.json
GOOGLE_CREDS_JSON=
SHEET_NAME=sociomed_db

# Database and queue
DATABASE_URL=postgresql://sociomed:sociomed_dev_password@localhost:5432/sociomed_local

REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Sales / go-to-market
SALES_AGENT_PHONE=+254700123456
SUPPORT_EMAIL=sales@sociomed.co
PUBLIC_BASE_URL=http://localhost:8000
ENABLE_OPEN_DOCS=true
DEFAULT_CURRENCY=UGX

# Runtime
SESSION_TTL=1800
SESSION_VERSION=1
CACHE_TTL_SECONDS=300
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
EXCHANGE_RATES_JSON=
EXCHANGE_RATES_LAST_UPDATED=2026-04-30
MAX_EXCHANGE_RATE_AGE_DAYS=14

# Logging
LOG_LEVEL=INFO
