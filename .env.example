# WhatsApp API
VERIFY_TOKEN=your_verify_token
WHATSAPP_TOKEN=your_whatsapp_token
PHONE_NUMBER_ID=your_phone_id
WHATSAPP_APP_SECRET=your_app_secret

# Google Sheets
GOOGLE_CREDS_FILE=credentials.json
SHEET_NAME=sociomed_db

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sociomed

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Sales / go-to-market
SALES_AGENT_PHONE=256700000000
SUPPORT_EMAIL=sales@sociomed.co
PUBLIC_BASE_URL=https://your-public-api-url.onrender.com
ENABLE_OPEN_DOCS=true

# Runtime
SESSION_TTL=1800
CACHE_TTL_SECONDS=300

# Logging
LOG_LEVEL=INFO

# Application
DEFAULT_CURRENCY=UGX
