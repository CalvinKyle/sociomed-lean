# Local development environment for SocioMed Lean
APP_ENV=development

# WhatsApp Cloud API
VERIFY_TOKEN=sociomed-local-webhook
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Google Sheets
GOOGLE_CREDS_FILE=.secrets/google-service-account.json
GOOGLE_CREDS_JSON=
SHEET_NAME=sociomed_db

# Database and queue
DATABASE_URL=postgresql://sociomed:sociomed_dev_password@localhost:5432/sociomed_local

REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Sales / go-to-market
SALES_AGENT_PHONE=+254700123456
SUPPORT_EMAIL=sales@socio-med.com
PUBLIC_BASE_URL=http://localhost:8000
ENABLE_OPEN_DOCS=true
DEFAULT_CURRENCY=UGX
API_KEY=sociomed-local-api-key
LAUNCH_MODE=true
ENABLE_FEATURED_OFFERS=false
ENABLE_CATEGORY_BROWSE=false
ENABLE_RELATED_PRODUCTS=false
EXPOSE_SUPPLIER_NAMES=false
MAX_AUTO_PFI_LEAD_TIME_DAYS=0

# Merchant identity and PFI terms (placeholders only; required before production PFI issuance)
MERCHANT_LEGAL_NAME=
MERCHANT_TRADING_NAME=
MERCHANT_TAGLINE=
MERCHANT_ADDRESS_LINES_JSON=[]
MERCHANT_PHONE_LINES_JSON=[]
MERCHANT_EMAIL=
MERCHANT_WEBSITE=
MERCHANT_TAX_ID=
MERCHANT_VAT_WORDING=
MERCHANT_BANK_NAME=
MERCHANT_BANK_ACCOUNT_NAME=
MERCHANT_BANK_ACCOUNT_NUMBER=
MERCHANT_BANK_BRANCH=
MERCHANT_BANK_SWIFT=
PFI_VALIDITY_DAYS=14
PFI_PAYMENT_TERMS=
PFI_DELIVERY_TERMS=
PFI_CONSUMABLES_WARRANTY=
PFI_EQUIPMENT_WARRANTY=
PFI_EQUIPMENT_INSTALLATION=
PFI_TECHNICAL_SUPPORT=

# Runtime
SESSION_TTL=1800
SESSION_VERSION=1
CACHE_TTL_SECONDS=300
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
EXCHANGE_RATES_JSON=
EXCHANGE_RATES_LAST_UPDATED=2026-04-30
MAX_EXCHANGE_RATE_AGE_DAYS=14

# Logging
LOG_LEVEL=INFO
